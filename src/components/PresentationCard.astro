---
import { t } from '../utils/i18n';
import { InteractiveCard } from './ui/InteractiveCard';

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: string;
  session?: number;
  sourceFolder?: string;
  cover?: string;
  tags?: string[];
}

const { title, description, slug, locale, sourceFolder, cover, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${locale}/presentations/${slug}/`;
---
<InteractiveCard client:visible id={`pres-${slug}`} data-tags={tags.join(',')}>
  <div class="card-cover-wrap">
    {cover && <img src={`${base}${cover}`} alt={title} class="card-cover" loading="lazy" />}
    {!cover && (
      <div class="card-cover card-cover-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="card-placeholder-icon">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>
    )}
    <div class="card-cover-overlay"></div>
    <div class="card-floating-badge">{locale === 'ar' ? 'محاضرة وسلايدات' : 'Lecture & Slides'}</div>
    <div class="slide-icon-overlay">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.15rem; height: 1.15rem; color: #fff;">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </div>
  </div>
  <div class="card-body">
    <h3 class="card-title"><a href={href} class="full-card-link">{title}</a></h3>
    <p class="card-desc">{description}</p>
  </div>
  <div class="card-footer">
    <div class="tag-list">
      {tags.slice(0, 2).map((tag) => <span class="tag-chip">#{tag}</span>)}
    </div>
    <div class="card-actions-group">
      {sourceFolder && (
        <a href={sourceFolder} target="_blank" rel="noopener" class="card-icon-btn" title="Slide Source" aria-label="Slides Source">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      )}
      <a href={href} class="card-action-link" title={title}>
        <span>{t(locale, 'viewSlides')}</span>
        <span class="card-arrow-icon">{locale === 'ar' ? '←' : '→'}</span>
      </a>
    </div>
  </div>
</InteractiveCard>
