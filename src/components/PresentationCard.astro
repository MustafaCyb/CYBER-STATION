---
import { t } from '../utils/i18n';
import { InteractiveCard } from './ui/InteractiveCard';

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: string;
  session?: number; // Kept in interface for compatibility with data schemas, but not rendered
  sourceFolder?: string;
  cover?: string;
  tags?: string[];
}

const { title, description, slug, locale, sourceFolder, cover, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${locale}/presentations/${slug}/`;
---
<InteractiveCard client:visible id={`pres-${slug}`} data-tags={tags.join(',')}>
  <div class="article-cover-wrap">
    {cover && <img src={`${base}${cover}`} alt={title} class="card-cover" loading="lazy" />}
    {!cover && (
      <div class="card-cover" style="background: var(--gradient-card); display: flex; align-items: center; justify-content: center;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 4rem; height: 4rem; opacity: 0.4; color: var(--accent-purple);">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>
    )}
    <div class="slide-icon-overlay">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.5rem; height: 1.5rem; color: #fff;">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </div>
  </div>
  <div class="card-body">
    <div class="card-category">Cyber Station Lectures</div>
    <h3 class="card-title"><a href={href}>{title}</a></h3>
    <p class="card-desc">{description}</p>
  </div>
  <div class="card-footer">
    <div class="tag-list">
      {tags.slice(0, 3).map((tag) => <span class="tag-chip">#{tag}</span>)}
    </div>
    {sourceFolder && (
      <a href={sourceFolder} target="_blank" rel="noopener" class="btn btn-sm btn-ghost">
        {t(locale, 'viewSlides')} <span style="margin-inline-start: 4px;">→</span>
      </a>
    )}
  </div>
</InteractiveCard>
