---
interface Props {
  tags: string[];
  locale: string;
}

const { tags, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{tags.length > 0 && (
  <div class="tag-list">
    {tags.map((tag) => (
      <a href={`${base}${locale}/tags/${tag}/`} class="tag-chip">#{tag}</a>
    ))}
  </div>
)}
