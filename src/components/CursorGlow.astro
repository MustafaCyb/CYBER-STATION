---
// Cursor Glow & 3D Tilt handler
---
<script is:inline>
(function() {
  // Only execute on devices with hover capabilities (desktop)
  if (!window.matchMedia('(hover: hover)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  let activeCard = null;

  document.addEventListener('mousemove', (e) => {
    const card = e.target.closest('.glass-card');
    
    if (activeCard && activeCard !== card) {
      // Reset previous card
      activeCard.style.transform = '';
      activeCard.style.setProperty('--glow-x', '50%');
      activeCard.style.setProperty('--glow-y', '50%');
      activeCard.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
      activeCard = null;
    }

    if (!card) return;
    activeCard = card;

    const rect = card.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    // Set glow coordinates
    card.style.setProperty('--glow-x', `${x}px`);
    card.style.setProperty('--glow-y', `${y}px`);

    // Calculate 3D tilt (range -3 to +3 degrees)
    const px = x / rect.width;
    const py = y / rect.height;
    const rotateX = (0.5 - py) * 6; // Y movement tilts around X axis
    const rotateY = (px - 0.5) * 6; // X movement tilts around Y axis

    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.015, 1.015, 1.015)`;
    card.style.transition = 'transform 0.1s cubic-bezier(0.25, 1, 0.5, 1)';
  });

  // Handle pointer leave to reset transitions smoothly
  document.addEventListener('pointerout', (e) => {
    const card = e.target.closest('.glass-card');
    if (card && (!e.relatedTarget || !e.relatedTarget.closest('.glass-card'))) {
      card.style.transform = '';
      card.style.setProperty('--glow-x', '50%');
      card.style.setProperty('--glow-y', '50%');
      card.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)';
      if (activeCard === card) activeCard = null;
    }
  });
})();
</script>
