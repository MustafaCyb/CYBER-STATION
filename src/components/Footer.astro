---
import { t } from '../utils/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <ul class="footer-links">
      <li><a href={`${base}${locale}/`}>{t(locale, 'home')}</a></li>
      <li><a href={`${base}${locale}/articles/`}>{t(locale, 'articles')}</a></li>
      <li><a href={`${base}${locale}/projects/`}>{t(locale, 'projects')}</a></li>
      <li><a href={`${base}${locale}/presentations/`}>{t(locale, 'presentations')}</a></li>
    </ul>
    <div class="footer-socials">
      <a href="https://github.com/MustafaCyb" target="_blank" rel="noopener" aria-label="GitHub" class="footer-social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
      </a>
      <a href="https://www.youtube.com/@cyb_sta" target="_blank" rel="noopener" aria-label="YouTube" class="footer-social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
      </a>
      <a href="https://t.me/cyb_st" target="_blank" rel="noopener" aria-label="Telegram" class="footer-social-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
      </a>
    </div>
    <p class="footer-copy">
      &copy; {year} CYBER STATION
    </p>
  </div>
</footer>
