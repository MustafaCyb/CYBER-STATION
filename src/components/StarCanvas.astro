---
// Galaxy star field canvas — animated background
---
<div class="space-background" aria-hidden="true">
  <div class="nebula-blob blob-1"></div>
  <div class="nebula-blob blob-2"></div>
  <div class="nebula-blob blob-3"></div>
  <canvas id="star-canvas"></canvas>
</div>

<style>
  .space-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--bg-deep);
    transition: background-color var(--transition-slow);
  }

  #star-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Nebula Blobs */
  .nebula-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
    mix-blend-mode: screen;
    pointer-events: none;
    transition: opacity var(--transition-slow), filter var(--transition-slow);
  }

  /* In light mode, lower opacity and change blend mode/opacity */
  :global([data-theme="light"]) .nebula-blob {
    opacity: 0.08;
    mix-blend-mode: multiply;
    filter: blur(140px);
  }

  .blob-1 {
    top: -10%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, var(--accent-purple) 0%, transparent 70%);
    animation: drift-1 45s ease-in-out infinite alternate;
  }

  .blob-2 {
    bottom: -15%;
    right: 5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, transparent 70%);
    animation: drift-2 55s ease-in-out infinite alternate-reverse;
  }

  .blob-3 {
    top: 30%;
    right: 20%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, var(--accent-pink) 0%, transparent 70%);
    animation: drift-3 38s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(100px, 80px) scale(1.2); }
  }

  @keyframes drift-2 {
    0% { transform: translate(0, 0) scale(1.1); }
    100% { transform: translate(-120px, -60px) scale(0.9); }
  }

  @keyframes drift-3 {
    0% { transform: translate(0, 0) scale(0.95); }
    100% { transform: translate(80px, -90px) scale(1.15); }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .nebula-blob {
      animation: none !important;
      display: none;
    }
    #star-canvas {
      display: none;
    }
  }
</style>

<script is:inline>
(function() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    return;
  }

  const canvas = document.getElementById('star-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let stars = [];
  let shootingStars = [];
  const STAR_COUNT = 250;
  
  const DARK_COLORS = ['#ffffff', '#c4b5fd', '#a5f3fc', '#f9a8d4', '#e2e8f0'];
  const LIGHT_COLORS = ['#d97706', '#7c3aed', '#0891b2', '#db2777', '#4f46e5'];

  let mouseX = 0;
  let mouseY = 0;
  let targetMouseX = 0;
  let targetMouseY = 0;
  let isMouseActive = false;

  function getTheme() {
    return document.documentElement.getAttribute('data-theme') || 'dark';
  }

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function createStars() {
    stars = [];
    const colors = getTheme() === 'dark' ? DARK_COLORS : LIGHT_COLORS;
    for (let i = 0; i < STAR_COUNT; i++) {
      const tier = Math.random();
      let speed, size;
      if (tier < 0.6) {
        speed = Math.random() * 0.05 + 0.01;
        size = Math.random() * 0.8 + 0.2;
      } else if (tier < 0.9) {
        speed = Math.random() * 0.12 + 0.05;
        size = Math.random() * 1.5 + 0.8;
      } else {
        speed = Math.random() * 0.25 + 0.12;
        size = Math.random() * 2.2 + 1.5;
      }

      stars.push({
        baseX: Math.random() * canvas.width,
        baseY: Math.random() * canvas.height,
        size: size,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: Math.random() * 0.7 + 0.3,
        speed: speed,
        twinkleSpeed: Math.random() * 0.01 + 0.002,
        twinkleDir: Math.random() > 0.5 ? 1 : -1,
        maxAlpha: Math.random() * 0.5 + 0.5,
        minAlpha: Math.random() * 0.2 + 0.1,
      });
    }
  }

  function triggerShootingStar() {
    if (document.hidden) {
      setTimeout(triggerShootingStar, 5000);
      return;
    }
    
    if (Math.random() > 0.3) {
      const side = Math.random() > 0.5 ? 'top' : 'right';
      let x, y, dx, dy;
      if (side === 'top') {
        x = Math.random() * (canvas.width * 0.6);
        y = 0;
      } else {
        x = canvas.width;
        y = Math.random() * (canvas.height * 0.5);
      }
      
      const angle = Math.PI * 0.75 + (Math.random() * 0.1 - 0.05);
      const speed = Math.random() * 8 + 6;
      dx = Math.cos(angle) * speed;
      dy = Math.sin(angle) * speed;

      shootingStars.push({
        x: x,
        y: y,
        dx: dx,
        dy: dy,
        length: Math.random() * 80 + 40,
        thickness: Math.random() * 1.5 + 0.8,
        life: 1.0,
        decay: Math.random() * 0.02 + 0.01,
        color: getTheme() === 'dark' ? 'rgba(165, 243, 252, ' : 'rgba(124, 58, 237, '
      });
    }
    setTimeout(triggerShootingStar, Math.random() * 6000 + 4000);
  }

  let lastTheme = getTheme();
  function checkThemeChange() {
    const currentTheme = getTheme();
    if (currentTheme !== lastTheme) {
      lastTheme = currentTheme;
      const colors = currentTheme === 'dark' ? DARK_COLORS : LIGHT_COLORS;
      for (const s of stars) {
        s.color = colors[Math.floor(Math.random() * colors.length)];
      }
    }
  }

  function draw() {
    checkThemeChange();
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (isMouseActive) {
      mouseX += (targetMouseX - mouseX) * 0.05;
      mouseY += (targetMouseY - mouseY) * 0.05;
    } else {
      mouseX += (0 - mouseX) * 0.02;
      mouseY += (0 - mouseY) * 0.02;
    }

    const theme = getTheme();
    const isDark = theme === 'dark';

    for (const s of stars) {
      s.baseY += s.speed;
      if (s.baseY > canvas.height + 5) {
        s.baseY = -5;
        s.baseX = Math.random() * canvas.width;
      }

      s.alpha += s.twinkleSpeed * s.twinkleDir;
      if (s.alpha >= s.maxAlpha) { s.alpha = s.maxAlpha; s.twinkleDir = -1; }
      if (s.alpha <= s.minAlpha) { s.alpha = s.minAlpha; s.twinkleDir = 1; }

      const strength = s.speed * 60;
      const offsetX = (mouseX / canvas.width - 0.5) * strength;
      const offsetY = (mouseY / canvas.height - 0.5) * strength;
      
      let x = s.baseX - offsetX;
      let y = s.baseY - offsetY;

      if (x < 0) x += canvas.width;
      if (x > canvas.width) x -= canvas.width;
      if (y < 0) y += canvas.height;
      if (y > canvas.height) y -= canvas.height;

      ctx.beginPath();
      if (isDark) {
        ctx.arc(x, y, s.size, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = s.alpha;
      } else {
        ctx.arc(x, y, s.size * 1.6, 0, Math.PI * 2);
        ctx.fillStyle = s.color;
        ctx.globalAlpha = s.alpha * 0.35;
      }
      ctx.fill();
    }

    for (let i = shootingStars.length - 1; i >= 0; i--) {
      const ss = shootingStars[i];
      ss.x += ss.dx;
      ss.y += ss.dy;
      ss.life -= ss.decay;

      if (ss.life <= 0 || ss.x < -100 || ss.y > canvas.height + 100) {
        shootingStars.splice(i, 1);
        continue;
      }

      ctx.beginPath();
      const grad = ctx.createLinearGradient(ss.x, ss.y, ss.x - ss.dx * ss.length * 0.1, ss.y - ss.dy * ss.length * 0.1);
      grad.addColorStop(0, `${ss.color}${ss.life})`);
      grad.addColorStop(1, `${ss.color}0)`);
      
      ctx.strokeStyle = grad;
      ctx.lineWidth = ss.thickness;
      ctx.lineCap = 'round';
      ctx.moveTo(ss.x, ss.y);
      ctx.lineTo(ss.x - ss.dx * ss.length * 0.15, ss.y - ss.dy * ss.length * 0.15);
      ctx.stroke();
    }

    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }

  window.addEventListener('mousemove', (e) => {
    targetMouseX = e.clientX;
    targetMouseY = e.clientY;
    isMouseActive = true;
  });

  document.addEventListener('mouseleave', () => {
    isMouseActive = false;
  });

  window.addEventListener('resize', () => {
    resize();
    createStars();
  });

  resize();
  createStars();
  draw();
  setTimeout(triggerShootingStar, 5000);
})();
</script>

