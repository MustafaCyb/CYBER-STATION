---
import { t } from '../utils/i18n';
import { InteractiveCard } from './ui/InteractiveCard';

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: string;
  category?: string;
  status?: string;
  tech?: string[];
  tags?: string[];
  repo?: string;
  cover?: string;
  safety?: string;
}

const { title, description, slug, locale, category, status = 'active', tech = [], tags = [], repo, cover, safety = 'defensive' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${locale}/projects/${slug}/`;
---
<InteractiveCard client:visible id={`project-${slug}`} data-tags={tags.join(',')}>
  <div class="card-cover-wrap">
    {cover && <img src={`${base}${cover}`} alt={title} class="card-cover" loading="lazy" />}
    {!cover && (
      <div class="card-cover card-cover-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="card-placeholder-icon">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
          <line x1="12" y1="2" x2="12" y2="22"></line>
        </svg>
      </div>
    )}
    <div class="card-cover-overlay"></div>
    {category && <div class="card-floating-badge">{category}</div>}
  </div>
  <div class="card-body">
    <h3 class="card-title"><a href={href} class="full-card-link">{title}</a></h3>
    <p class="card-desc">{description}</p>

    {tech.length > 0 && (
      <div class="tech-badges">
        {tech.slice(0, 4).map((t) => <span class="tech-badge">{t}</span>)}
      </div>
    )}
  </div>

  <div class="card-footer">
    <div class="card-badges-group">
      <span class={`status-pill ${status}`}>{t(locale, status)}</span>
      {safety !== 'defensive' && (
        <span class={`safety-label ${safety}`}>{t(locale, safety)}</span>
      )}
    </div>
    <div class="card-actions-group">
      {repo && (
        <a href={repo} target="_blank" rel="noopener" class="card-icon-btn" title="GitHub Source" aria-label="GitHub Repository">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      )}
      <a href={href} class="card-action-link" title={title}>
        <span>{locale === 'ar' ? 'عرض' : 'View'}</span>
        <span class="card-arrow-icon">{locale === 'ar' ? '←' : '→'}</span>
      </a>
    </div>
  </div>
</InteractiveCard>
