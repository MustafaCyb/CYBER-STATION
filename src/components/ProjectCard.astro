---
import { t } from '../utils/i18n';
import { InteractiveCard } from './ui/InteractiveCard';

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: string;
  category?: string;
  status?: string;
  tech?: string[];
  tags?: string[];
  repo?: string;
  cover?: string;
  safety?: string;
}

const { title, description, slug, locale, category, status = 'active', tech = [], tags = [], repo, cover, safety = 'defensive' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${locale}/projects/${slug}/`;
---
<InteractiveCard client:visible id={`project-${slug}`} data-tags={tags.join(',')}>
  {cover && <img src={`${base}${cover}`} alt={title} class="card-cover" loading="lazy" />}
  <div class="card-body">
    {category && <div class="card-category">{category}</div>}
    <h3 class="card-title"><a href={href}>{title}</a></h3>
    <p class="card-desc">{description}</p>

    {tech.length > 0 && (
      <div class="tech-badges" style="margin-bottom: var(--space-md);">
        {tech.map((t) => <span class="tech-badge">{t}</span>)}
      </div>
    )}
  </div>

  <div class="card-footer">
    <div style="display: flex; align-items: center; gap: var(--space-sm);">
      <span class={`status-pill ${status}`}>{t(locale, status)}</span>
      {safety !== 'defensive' && (
        <span class={`safety-label ${safety}`}>{t(locale, safety)}</span>
      )}
    </div>
    {repo && (
      <a href={repo} target="_blank" rel="noopener" class="btn btn-sm btn-ghost" title="GitHub">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    )}
  </div>
</InteractiveCard>
