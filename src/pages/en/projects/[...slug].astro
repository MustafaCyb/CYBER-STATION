---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagList from '../../../components/TagList.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../utils/i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.locale === 'en' && !p.data.draft);
  return projects.map(project => ({
    params: { slug: project.data.itemSlug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const locale = 'en';
const base = import.meta.env.BASE_URL;
const techList: string[] = project.data.tech || [];
---
<BaseLayout title={project.data.title} description={project.data.description} locale={locale}>
  <div class="container">
    <article style="max-width: 800px; margin: 0 auto;">
      {project.data.cover && (
        <div style="border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-2xl); border: 1px solid var(--glass-border);">
          <img src={`${base}${project.data.cover}`} alt={project.data.title} style="width: 100%; height: 300px; object-fit: cover;" />
        </div>
      )}

      <header style="margin-bottom: var(--space-2xl); padding-bottom: var(--space-xl); border-bottom: 1px solid var(--glass-border);">
        <div style="display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); flex-wrap: wrap;">
          {project.data.category && <span class="card-category">{project.data.category}</span>}
          <span class={`status-pill ${project.data.status}`}>{t(locale, project.data.status)}</span>
          {project.data.safety !== 'defensive' && (
            <span class={`safety-label ${project.data.safety}`}>{t(locale, project.data.safety)}</span>
          )}
        </div>

        <h1 class="page-title">{project.data.icon} {project.data.title}</h1>
        <p class="page-subtitle">{project.data.description}</p>

        <div style="display: flex; gap: var(--space-md); margin-top: var(--space-lg); flex-wrap: wrap;">
          {project.data.repo && (
            <a href={project.data.repo} target="_blank" rel="noopener" class="btn btn-primary">
              {t(locale, 'viewOnGithub')}
            </a>
          )}
          <a href={`${base}en/projects/`} class="btn btn-ghost">← {t(locale, 'allProjects')}</a>
        </div>
      </header>

      {techList.length > 0 && (
        <div class="tech-badges" style="margin-bottom: var(--space-xl);">
          {techList.map((tech) => <span class="tech-badge">{tech}</span>)}
        </div>
      )}

      <div class="prose">
        <Content />
      </div>

      {project.data.tags.length > 0 && (
        <div style="margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--glass-border);">
          <TagList tags={project.data.tags} locale={locale} />
        </div>
      )}
    </article>
  </div>
</BaseLayout>
