---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

const locale = 'en';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={t(locale, 'aboutTitle')} locale={locale} description={t(locale, 'aboutDesc')}>
  <div class="container">
    <header style="margin-bottom: var(--space-3xl); text-align: center;">
      <h1 class="page-title"><span class="gradient-text">{t(locale, 'aboutTitle')}</span></h1>
      <p class="page-subtitle" style="margin: 0 auto;">{t(locale, 'aboutDesc')}</p>
    </header>

    <div class="about-grid">
      <div class="glass-card" style="padding: var(--space-xl);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: var(--space-lg); display: flex; align-items: center; gap: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.35rem; height: 1.35rem; color: var(--accent-purple);"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
          Mission
        </h2>
        <div class="prose" style="max-width: none;">
          <p>Cyber Station is a cybersecurity learning and research platform focused on building practical skills through open-source tools, in-depth articles, and hands-on lecture presentations.</p>
          <p>We believe in learning by doing — every project in our portfolio is a real tool that solves real security challenges. From AI-powered reconnaissance to digital forensics, our work spans the full spectrum of cybersecurity.</p>
        </div>
      </div>

      <div class="glass-card" style="padding: var(--space-xl);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: var(--space-lg); display: flex; align-items: center; gap: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.35rem; height: 1.35rem; color: var(--accent-cyan);"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
          What We Do
        </h2>
        <div class="prose" style="max-width: none;">
          <ul>
            <li><strong>Build Tools</strong> — Open-source security tools like TwinSanity Recon and Digital Forensic Tool Kit</li>
            <li><strong>Teach</strong> — Lecture series covering fundamentals to advanced offensive security</li>
            <li><strong>Research</strong> — Articles on emerging threats, techniques, and defense strategies</li>
            <li><strong>Share</strong> — Everything is open-source and freely available</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="glass-card" style="padding: var(--space-xl); margin-top: var(--space-2xl); text-align: center;">
      <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: var(--space-lg); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 1.35rem; height: 1.35rem; color: var(--accent-pink);"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        Connect
      </h2>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; align-items: center;">
        <a href="https://github.com/MustafaCyb" target="_blank" rel="noopener" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          GitHub Profile
        </a>
        <a href="https://www.youtube.com/@cyb_sta" target="_blank" rel="noopener" class="btn btn-ghost" style="display: inline-flex; align-items: center; gap: 0.5rem; border-color: rgba(239, 68, 68, 0.4); color: #ef4444;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          YouTube Channel
        </a>
        <a href="https://t.me/cyb_st" target="_blank" rel="noopener" class="btn btn-ghost" style="display: inline-flex; align-items: center; gap: 0.5rem; border-color: rgba(6, 182, 212, 0.4); color: #06b6d4;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
          Telegram Channel
        </a>
        <a href={`${base}en/projects/`} class="btn btn-ghost">{t(locale, 'exploreProjects')}</a>
      </div>
    </div>
  </div>
</BaseLayout>
